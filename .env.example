# Copie este arquivo para ".env" e preencha com a sua chave.
# O arquivo ".env" é ignorado pelo Git (veja .gitignore). Nunca publique a chave.

# Chave gratuita em https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional: troque o modelo se o padrão não estiver disponível para você
# GEMINI_MODEL=gemini-2.5-flash
